{
  "name": "@x402check/ai-sdk",
  "version": "0.1.1",
  "description": "x402check for the Vercel AI SDK: a tool-approval policy that screens the counterparty before a tool moves money (allow → runs, warn → asks the user, block → denied), and a risk-check tool for the model. Signed, paid verdicts; no free tier.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caiovicentino/jev-risk-check-provider.git",
    "directory": "packages/ai-sdk"
  },
  "homepage": "https://x402check.xyz",
  "bugs": "https://github.com/caiovicentino/jev-risk-check-provider/issues",
  "keywords": [
    "ai-sdk",
    "vercel-ai",
    "tool-approval",
    "x402",
    "x402check",
    "risk-check",
    "ai-agents",
    "wallet"
  ],
  "license": "MIT",
  "dependencies": {
    "@x402check/client": "^0.5.3"
  },
  "peerDependencies": {
    "ai": ">=7.0.153 <8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ai": "^7.0.153",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "zod": "^4.6.7"
  }
}
