{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@metamask/snaps-sdk",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["index.tsx", "src/**/*.ts", "src/**/*.tsx"]
}
