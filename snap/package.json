{
  "name": "x402check-snap",
  "version": "0.2.0",
  "private": true,
  "description": "x402check pre-payment gate for MetaMask: signed-intent risk checks on every transaction and signature, before the user signs.",
  "license": "MIT",
  "main": "dist/bundle.js",
  "files": [
    "dist/",
    "snap.manifest.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "bash ./build-via-tmp.sh",
    "serve": "mm-snap serve",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "npm run build && npm run test:only",
    "test:only": "jest",
    "test:unit": "jest test/unit"
  },
  "devDependencies": {
    "@metamask/snaps-cli": "^8.0.0",
    "@metamask/snaps-jest": "9.1.0",
    "@metamask/snaps-sdk": "^8.0.0",
    "@metamask/snaps-simulation": "3.1.0",
    "@swc/jest": "^0.2.39",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/caiovicentino/jev-risk-check-provider"
  },
  "overrides": {
    "@metamask/snaps-simulation": {
      "@metamask/snaps-rpc-methods": "13.1.0"
    },
    "@metamask/snaps-controllers": {
      "@metamask/snaps-rpc-methods": "13.1.0"
    }
  }
}
